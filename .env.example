# FastAPI-Flask SimpleTaskBoard Security Configuration
# Copy this file to .env and customize for your environment
# NEVER commit .env to version control!

# Application Configuration
ENV=production
DEBUG=false
SECRET_KEY=your-super-secret-key-here-minimum-32-characters-long
API_VERSION=1.0.0

# Database Configuration
DATABASE_URL=sqlite:///./taskboard.db
# For PostgreSQL: postgresql://user:password@localhost/dbname
# For MySQL: mysql://user:password@localhost/dbname

# Security Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
ENABLE_DOCS=false

# JWT Configuration  
JWT_SECRET_KEY=your-jwt-secret-key-here-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=10

# CORS Configuration
CORS_MAX_AGE=600

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=logs/taskboard.log

# Performance Configuration
WORKERS=1
MAX_CONNECTIONS=100
KEEPALIVE_TIMEOUT=65

# Security Headers
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'

# Development Only (Remove in Production)
ENABLE_TESTING_ENDPOINTS=false
ENABLE_DEBUG_TOOLBAR=false